# Binaries and build output
/bin/
/dist/
# GoReleaser output dir when invoked from the cmd/radx module (its config lives there).
/cmd/radx/dist/
/cmd/radx/radx
# MkDocs build output (generated by `mkdocs build`; the CI docs job builds it fresh).
/site/
*.exe
*.test
*.out

# Coverage — anchored to the repo root so the generated fhir/r5/coverage.go (a FHIR
# Coverage resource) is not swept up by the coverage-profile ignore.
*.coverprofile
/coverage.*
cover.html

# bench-compare harness: synced Python env and per-run outputs (the committed doc is the artifact)
/tools/bench-compare/.venv/
/tools/bench-compare/results/

# Go workspace lock file (generated; the committed go.work ties the root and cmd/radx modules)
go.work.sum

# OS / editor
.DS_Store
*.swp
*~

# Agent worktrees (isolated per-task checkouts; never committed)
.claude/worktrees/

# Environment / secrets (never commit; see PRD §9.8)
.env
.env.*
!.env.example

# bench-compare local artifacts (the harness writes results JSON/md; the gobench binary is built on demand)
tools/bench-compare/results/
tools/bench-compare/gobench/gobench
tools/bench-compare/.venv/
