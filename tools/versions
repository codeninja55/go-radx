# Reference-tool and interop-image pins for the go-radx conformance and interop gates.
#
# This is the single human-readable manifest of every external reference tool and container image the
# gates depend on, recorded so an interop or conformance result is reproducible rather than dependent
# on whatever a runner resolves at install time. The pins themselves live next to where each tool is
# invoked — this file is the index and the rationale, and tools/pin-drift.sh asserts none of the live
# references float back to an unpinned tag.
#
# Format: one `key=value` per line; `#` starts a comment. Keys are lowercase, dot-separated.
# Bumping any pin is a deliberate, reviewed change: re-resolve the version/digest, update the live
# reference (the file noted under each entry), and update this manifest in the same commit.

# --- Go toolchain and scanners (live pins owned by P0-7; recorded here for one-stop visibility) ---
# go: mise.toml [tools], both go.mod files, ci.yml govulncheck job.
go=1.26.4
# golangci-lint: mise.toml [tools].
golangci-lint=2.12.2
# govulncheck: ci.yml `go install golang.org/x/vuln/cmd/govulncheck@vX.Y.Z`.
govulncheck=1.3.0

# --- DICOM conformance tools (live pins in .github/workflows/ci.yml, conformance job) ---
# dicom3tools provides dciodvfy. Pinned to the exact Ubuntu noble archive version via apt; apt has no
# point-in-time snapshot, so if the runner rolls the package forward the install fails loudly (the
# intended re-pin signal). Re-resolve with `apt-cache policy dicom3tools`.
dicom3tools=1.00~20240118131615-1
# pydicom round-trip gate. 3.x is required: the gate uses save_as(enforce_file_format=...), a 3.0 API.
pydicom=3.0.2

# --- Documentation site toolchain (live pins in .github/workflows/ci.yml, docs job) ---
# The conformance site is built with `mkdocs build --strict` (mise run docs:build). The docs job
# installs both at exact == pins from PyPI so the strict build is reproducible; bumping either is a
# deliberate change made here and at the install site together.
mkdocs=1.6.1
mkdocs-material=9.6.21

# --- Interop container images (live pins in the testcontainers helpers; digest-pinned) ---
# Orthanc: dimse/integration/orthanc/orthanc.go and dicomweb/integration/orthanc/orthanc.go.
orthanc.image=orthancteam/orthanc:26.6.0
orthanc.digest=sha256:510ef4ce24699104244b00d2b93350a801fc2f1c6b0bfc6a1f15e546bff2d1f4
# dcm4chee-arc three-container stack: dimse/integration/dcm4chee/dcm4chee.go.
dcm4chee.slapd.image=dcm4che/slapd-dcm4chee:2.6.10-34.2
dcm4chee.slapd.digest=sha256:5c04ced61e943af2175c69ec7955c28bbaf676c50b5876c02e1437261cfaeefc
dcm4chee.postgres.image=dcm4che/postgres-dcm4chee:17.4-34
dcm4chee.postgres.digest=sha256:728c3055b894127c661a1645ffd0ccc2ad6461b86e957e245a9cc9bbc9c499e2
dcm4chee.arc.image=dcm4che/dcm4chee-arc-psql:5.34.2
dcm4chee.arc.digest=sha256:316eba283d3c8538e4c3b954edcdd59572f76aa7271ca6336ddf771703082f8c
# python-hl7 MLLP peer (HL7 v2.x interop gate): hl7v2/integration/hl7peer/hl7peer.go. The peer
# container is the official Python slim image pinned by digest; the peer library is python-hl7
# (pinned below), pip-installed at container start at its exact `==` pin.
mllp-peer.python.image=docker.io/library/python:3.13.11-slim
mllp-peer.python.digest=sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e
# testcontainers host-access sshd sidecar: the MLLP reverse direction (HostAccessPorts) makes
# testcontainers-go start an sshd tunnel container from a reference hardcoded in the module
# (port_forwarding.go const sshdImage). There is no public override to digest-pin it (verified in
# v0.40.0: the const feeds an internal Run call; TESTCONTAINERS_HUB_IMAGE_NAME_PREFIX only rewrites
# the registry prefix for mirrors), so the pin is transitive — go.sum fixes the module version,
# which fixes this tag. tools/pin-drift.sh asserts the module's live reference matches this entry,
# so a testcontainers-go bump that floats the sidecar fails the gate until both move together.
mllp-peer.sshd.image=testcontainers/sshd:1.3.0
# HAPI FHIR server (FHIR REST client interop gate): fhir/rest/integration/hapi/hapi.go.
hapi.image=hapiproject/hapi:v8.10.0-1
hapi.digest=sha256:1be4d7ffe7a35a9fb46151851e5a20b25c5016f16c8ef8b59b0c807ad06a40c1

# --- CGo pixel codec sources (live pins in .github/workflows/ci.yml, codecs job) ---
# The C-backed pixel codecs are built from source in CI (Ubuntu apt ships older releases — notably
# libjpeg-turbo 2.x, which lacks the TJPARAM_LOSSLESS API codec_libjpeg.go uses). Each source tarball
# is downloaded to a file and verified against the SHA-256 below (fail-closed) before extraction, so
# the codecs result is reproducible and a tampered or truncated mirror response cannot reach the
# build. The pinned versions match what the local build links via Homebrew. Bumping any pin is a
# deliberate, reviewed change: re-download the tarball, recompute the SHA-256, and update the version
# and sha256 keys here together with the install site in ci.yml.
# OpenJPEG: GitHub source archive (archive/refs/tags/v<version>.tar.gz).
codec.openjpeg.version=2.5.4
codec.openjpeg.sha256=a695fbe19c0165f295a8531b1e4e855cd94d0875d2f88ec4b61080677e27188a
# libjpeg-turbo: GitHub release asset (releases/download/<version>/libjpeg-turbo-<version>.tar.gz).
codec.libjpeg-turbo.version=3.1.4
codec.libjpeg-turbo.sha256=e23d3ebb2c6ee4d0e2a5823dbb55b614845df5ea3435c956fed5cf04041a87ad
# CharLS: GitHub source archive (archive/refs/tags/<version>.tar.gz).
codec.charls.version=2.4.3
codec.charls.sha256=bbf67d51446a98eb8fc98c9c6de49a2605c709d3a14ba39f09a09f8e57527099

# --- FHIR validator (live pin in .github/workflows/ci.yml fhir-conformance job + tools/fhir-conformance/validate.sh) ---
# Mechanism decision: the official HL7 validator_cli.jar (hapifhir/org.hl7.fhir.core releases), NOT a
# container. Rationale: the jar is the canonical reference, runs on the JDK every runner can install,
# pins to a single immutable GitHub release asset, and avoids a second container registry dependency.
# The M6a gate (tools/fhir-conformance/validate.sh) downloads exactly this release asset (URL derived
# from the version) and verifies the SHA-256 below before running it. Bumping the pin is a deliberate,
# reviewed change: re-download the asset, recompute the SHA-256, and update both keys here together.
fhir-validator.mechanism=validator_cli.jar
fhir-validator.source=https://github.com/hapifhir/org.hl7.fhir.core/releases/tag/6.9.9
fhir-validator.version=6.9.9
fhir-validator.sha256=3621e140c6c149d99dfac01c8310377c95ce136d8b4c8a61d32f68768e87f267

# --- Python reference libraries ---
# pynetdicom is a parity/shape reference only, not installed by any current gate. Recorded for the
# determinism contract: if a future gate installs it, it must pin the version here and at the
# install site, and tools/pin-drift.sh will require a pinned `==` / git ref.
pynetdicom=3.0.4
# python-hl7 publishes on PyPI under the distribution name `hl7`. It IS installed by a gate: the
# MLLP interop peer container (hl7v2/integration/hl7peer/hl7peer.go) pip-installs `hl7==0.4.5` at
# container start, and tools/pin-drift.sh enforces the exact `==` pin on that install line.
python-hl7=0.4.5
